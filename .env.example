# Base URL of the FastAPI backend, e.g. http://localhost:8000
# Leave empty to run the app fully mock (simulated auth, upload and projects,
# no backend required). This is the only switch between mock and real mode.
NEXT_PUBLIC_API_URL=

# The demo host. Set it to the plain http:// address — that is safe here.
#
# The app never lets the browser load an http:// URL in the iframe: anything
# that is not an https:// origin is routed through the same-origin proxy at
# /api/audio-proxy instead, so mixed content can never block it. Only an
# https:// value is embedded directly, which means putting TLS on the demo host
# later needs nothing but a new value here.
#
# NEXT_PUBLIC_ is inlined at BUILD time — changing it requires a rebuild.
NEXT_PUBLIC_DEMO_URL=http://3.145.34.87:8501

# Optional. Where proxy.ts forwards /api/audio-proxy, if that should differ from
# NEXT_PUBLIC_DEMO_URL above (which it falls back to). Server-only and read at
# request time, so this one can be changed with a restart instead of a rebuild.
# The prefix is stripped before forwarding, so Streamlit needs no server-side
# change — it can keep running at the root of its own host.
DEMO_ORIGIN=

# NOTE: the NEXT_PUBLIC_SUPABASE_* / SUPABASE_* keys are gone. Object storage
# moved to S3 (the backend mints presigned POSTs, so the browser never talks to
# Supabase), and admin is now the backend's `users.role` column rather than the
# NEXT_PUBLIC_ADMIN_EMAILS allowlist.
